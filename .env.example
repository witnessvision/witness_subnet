# Production MP4 5.2: copy only the selected credential to a private 0600 file.
# Set validator.json "env" to that file; an exported key alone is insufficient.
# judge_provider=saygm (default) requires GM_API_KEY; openai requires OPENAI_API_KEY.
# No second key is required. See docs/validator.md for assets and configuration.
GM_API_KEY=
OPENAI_API_KEY=

# Legacy synthetic --mainnet variables below; that workflow needs no API key.
# The legacy CLI does not automatically load .env files.
WITNESS_NETWORK=finney
WITNESS_WALLET=default
WITNESS_HOTKEY=default
# WITNESS_WALLET_PATH=/path/to/wallets
# WITNESS_TOOL_PUBLIC_URL=http://YOUR_PUBLIC_IP:8765
# WITNESS_SET_WEIGHTS=0  # disable submissions for diagnostics
# The advanced CLI (without --mainnet) uses WITNESS_NETUID; Witness is subnet20.
WITNESS_NETUID=20

# A stable role-owned ledger, outside releases/caches, is required for paid calls.
# Set validator.json "budget_path" to /var/lib/witness-validator/budget/daily.sqlite3.
