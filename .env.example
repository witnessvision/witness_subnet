# Optional exported variables for the --mainnet preset; no API key is needed.
# The CLI does not automatically load .env files.
WITNESS_NETWORK=finney
WITNESS_WALLET=default
WITNESS_HOTKEY=default
# WITNESS_WALLET_PATH=/path/to/wallets
# WITNESS_TOOL_PUBLIC_URL=http://YOUR_PUBLIC_IP:8765
# WITNESS_SET_WEIGHTS=0  # disable submissions for diagnostics
# The advanced CLI (without --mainnet) uses WITNESS_NETUID; Witness is subnet20.
WITNESS_NETUID=20

# Production semantic evaluator: select exactly one provider in validator config.
GM_API_KEY=
OPENAI_API_KEY=
# A stable role-owned ledger, outside releases/caches, is required for paid calls.
# WITNESS_BUDGET_DB=/var/lib/witness-validator/budget/daily.sqlite3
