# Copy only required API credentials into an operator-owned private 0600 file.
# witness-validator and witness-gpu-watchdog load it only with --env PATH.
# provider=openai uses OPENAI_API_KEY; provider=saygm uses GM_API_KEY.
OPENAI_API_KEY=
GM_API_KEY=
# Only the optional RunPod backend requires this token.
RUNPOD_API_KEY=
# No wallet seeds, private keys, passwords or challenge-payment settings here.
# Witness charges no challenge fee. See docs/validator.md for persistent budgets.

# Operator override only; --set-weights is still required to send weights.
BURN_ALL=0
